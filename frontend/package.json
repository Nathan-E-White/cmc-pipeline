{
  "name": "cmc-frontend-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["monitor", "app"],
  "scripts": {
    "dev:monitor": "bun run --cwd monitor dev",
    "dev:app": "bun run --cwd app dev",
    "build:monitor": "bun run --cwd monitor build",
    "build:app": "bun run --cwd app build",
    "test:monitor": "bun run --cwd monitor test",
    "test:app": "bun run --cwd app test",
    "test": "bun run test:monitor && bun run test:app && bun test app-boundaries.test.ts",
    "check": "biome check monitor/src app/src && bun run --cwd monitor check && bun run --cwd app check",
    "generate-routes": "bun run --cwd monitor generate-routes && bun run --cwd app generate-routes",
    "format": "biome format",
    "lint": "biome lint"
  },
  "devDependencies": {
    "@electric-sql/client": "1.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/solid-db": "^0.2.41",
    "@tanstack/solid-query": "^5.102.8",
    "@tanstack/solid-router": "latest",
    "@tanstack/solid-router-devtools": "latest",
    "@tanstack/solid-start": "latest",
    "@tanstack/solid-table": "^9.2.4",
    "@tanstack/solid-virtual": "^3.13.12",
    "solid-js": "^1.9.12",
    "solid-three": "^0.2.0",
    "tailwindcss": "^4.1.18",
    "@biomejs/biome": "2.4.5",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/intent": "^0.3.7",
    "@tanstack/router-cli": "^1.133.21",
    "@types/bun": "^1.4.0",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
