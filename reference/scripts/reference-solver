#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: reference-solver <verify-case|solve-case|export-r0-field-case|converge-case|solve-bridged-case|converge-bridged-case|converge-reversible-cohesive-case> --output <directory>" >&2
  exit 64
}

command="${1:-}"
[[ "${command}" == "verify-case" || "${command}" == "solve-case" || "${command}" == "export-r0-field-case" || "${command}" == "converge-case" || "${command}" == "solve-bridged-case" || "${command}" == "converge-bridged-case" || "${command}" == "converge-reversible-cohesive-case" ]] || usage
shift
[[ "${1:-}" == "--output" && -n "${2:-}" ]] || usage
output_dir="$2"
mkdir -p "${output_dir}"

# The runner owns numerical files only.  On successful completion it supplies a
# declarative artifact manifest; the host-side Case Executor validates and publishes it.
write_artifact_manifest() {
  status=$?
  [[ "${status}" -eq 0 ]] || exit "${status}"
  python3 - "${output_dir}" "${command}" <<'PY'
import json
import mimetypes
import sys
from pathlib import Path

root = Path(sys.argv[1])
if sys.argv[2] == "export-r0-field-case":
    required = ["displacement.xdmf", "displacement.h5"]
    if not all((root / name).is_file() for name in required):
        raise SystemExit("field export requires XDMF and HDF5 displacement artifacts")
    try:
        audit = json.loads((root / "mesh-audit.json").read_text(encoding="utf-8"))
        solution = json.loads((root / "solution-summary.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"field export acceptance evidence is unreadable: {error}")
    if audit.get("status") != "accepted" or solution.get("status") != "solved":
        raise SystemExit("field export did not pass mesh-audit and solved-status acceptance gates")
    acceptance = {
        "version": "cmc.r0-field-acceptance.v1", "status": "accepted",
        "gates": {"mesh_audit": "accepted", "solution": "solved"},
        "claim_boundary": "Local-development reference acceptance only; not physical validation.",
    }
    (root / "field-acceptance.json").write_text(json.dumps(acceptance, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    field_set = {
        "version": "cmc.field-set-manifest.v1",
        "field": {
            "id": "displacement", "name": "displacement_mm", "units": "mm",
            "association": "node", "components": 3,
            "xdmf_role": "field/displacement/xdmf", "hdf5_role": "field/displacement/hdf5",
        },
        "claim_boundary": "Declared local-development reference evidence; not physical validation.",
        "acceptance_role": "field/displacement/acceptance",
    }
    (root / "field-set-manifest.json").write_text(json.dumps(field_set, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    artifacts = [
        {"role": "field-set-manifest", "path": "field-set-manifest.json", "media_type": "application/vnd.cmc.field-set-manifest+json"},
        {"role": "field/displacement/xdmf", "path": "displacement.xdmf", "media_type": "application/x-xdmf+xml"},
        {"role": "field/displacement/hdf5", "path": "displacement.h5", "media_type": "application/x-hdf5"},
        {"role": "field/displacement/acceptance", "path": "field-acceptance.json", "media_type": "application/vnd.cmc.r0-field-acceptance+json"},
    ]
    (root / "artifact-manifest.json").write_text(json.dumps({"artifacts": artifacts}, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    raise SystemExit(0)
artifacts = []
for path in sorted(root.iterdir()):
    if not path.is_file() or path.name == "artifact-manifest.json":
        continue
    media_type, _ = mimetypes.guess_type(path.name)
    artifacts.append({
        "role": f"runner-output/{path.name}",
        "path": path.name,
        "media_type": media_type or "application/octet-stream",
    })
(root / "artifact-manifest.json").write_text(
    json.dumps({"artifacts": artifacts}, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY
}
trap write_artifact_manifest EXIT

case_card="/opt/cmc/cases/edge-cracked-plate-v1.json"
case_id="edge-cracked-plate-v1"
if [[ "${command}" == "solve-bridged-case" || "${command}" == "converge-bridged-case" ]]; then
  case_card="/opt/cmc/cases/edge-cracked-plate-bridged-v2.json"
  case_id="edge-cracked-plate-bridged-v2"
fi
if [[ "${command}" == "converge-reversible-cohesive-case" ]]; then
  python3 /opt/cmc/python/converge_reversible_cohesive_edge_crack.py \
    --case-card /opt/cmc/cases/edge-cracked-plate-reversible-v2.json \
    --case /opt/cmc/cases/edge-cracked-plate-v1.geo \
    --output "${output_dir}" \
    --generator /opt/cmc/python/generate_edge_crack_mesh.py \
    --mesh-audit /usr/local/bin/mesh-audit \
    --artifact-validator /opt/cmc/python/validate_opened_crack_mesh_artifacts.py \
    --program-runner /opt/cmc/python/run_reversible_cohesive_program.py \
    --single-step-solver /opt/cmc/python/solve_reversible_cohesive_edge_crack.py \
    --visualizer /opt/cmc/python/render_edge_crack_visual.py
  exit 0
fi
mesh_path="${output_dir}/${case_id}.msh"
if [[ "${command}" == "converge-case" || "${command}" == "converge-bridged-case" ]]; then
  python3 /opt/cmc/python/converge_edge_crack.py \
    --case-card "${case_card}" \
    --case /opt/cmc/cases/edge-cracked-plate-v1.geo \
    --output "${output_dir}" \
    --generator /opt/cmc/python/generate_edge_crack_mesh.py \
    --solver /opt/cmc/python/solve_edge_crack.py \
    --mesh-audit /usr/local/bin/mesh-audit \
    --visualizer /opt/cmc/python/render_edge_crack_visual.py
  exit 0
fi

python3 /opt/cmc/python/generate_edge_crack_mesh.py --case /opt/cmc/cases/edge-cracked-plate-v1.geo \
  --output "${mesh_path}" --near-size 2 --far-size 10
/usr/local/bin/mesh-audit "${mesh_path}" "${output_dir}/mesh-audit.json"

if [[ "${command}" == "solve-case" || "${command}" == "export-r0-field-case" || "${command}" == "solve-bridged-case" ]]; then
  python3 /opt/cmc/python/solve_edge_crack.py --mesh "${mesh_path}" --output "${output_dir}" \
    --case-card "${case_card}"
fi

python3 - "${output_dir}/environment.json" "${command}" "${case_card}" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

import dolfinx

case_card = json.loads(Path(sys.argv[3]).read_text(encoding="utf-8"))
solved = sys.argv[2] in {"solve-case", "solve-bridged-case"}
payload = {
    "gmsh_version": subprocess.check_output(["gmsh", "-version"], text=True).strip(),
    "dolfinx_version": getattr(dolfinx, "__version__", "unknown"),
    "case_id": case_card["case_id"],
    "claim_boundary": case_card["claim_boundary"] if solved else "Meshing and audit only; no reference solution has been executed.",
}
with open(sys.argv[1], "w", encoding="utf-8") as stream:
    json.dump(payload, stream, indent=2, sort_keys=True)
    stream.write("\n")
PY
